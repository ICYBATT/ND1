{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build cpp project",
      "type": "shell",
      "command": "cl",
      "args": [
        "/EHsc",
        "*.cpp",
        "/Fe:main.exe"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}